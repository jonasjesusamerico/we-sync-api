# ─────────────────────────────────────────────────────────────────────────────
# GET BY ID  GET /purchases/{id}  → 200 | 404
# ─────────────────────────────────────────────────────────────────────────────

### GET BY ID — Existing ID

GET {{baseUrl}}/purchases/1
Authorization: Bearer {{accessToken}}

### GET BY ID — Unknown ID → 404

GET {{baseUrl}}/purchases/999999
Authorization: Bearer {{accessToken}}

### GET BY ID — Invalid ID (non-numeric) → 400

GET {{baseUrl}}/purchases/abc
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# LIST  GET /purchases  → 200
# Pagination: page (default 1), page_size (default 20, max 100)
# ─────────────────────────────────────────────────────────────────────────────

### LIST — No filters (page 1, 20 items)

GET {{baseUrl}}/purchases
Authorization: Bearer {{accessToken}}

### LIST — Filter by month and year

GET {{baseUrl}}/purchases?month=7&year=2024
Authorization: Bearer {{accessToken}}

### LIST — Filter by status PENDING

GET {{baseUrl}}/purchases?status=PENDING
Authorization: Bearer {{accessToken}}

### LIST — Filter by category (exact ID)

GET {{baseUrl}}/purchases?category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Filter by payment method (exact ID)

GET {{baseUrl}}/purchases?payment_method_id=4
Authorization: Bearer {{accessToken}}

### LIST — Combined filter: month + year + status + category

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Full filter with pagination

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3&payment_method_id=4&page=1&page_size=10
Authorization: Bearer {{accessToken}}

### LIST — Month of the new front (page_size 8) → 200 with total and total_amount

GET {{baseUrl}}/purchases?year=2026&month=11&page=1&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Search ignoring accents and case → 200

GET {{baseUrl}}/purchases?year=2026&month=11&q=padaria&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Search with uppercase and no accent → 200

GET {{baseUrl}}/purchases?year=2026&month=11&q=SAO&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Search with a literal percent sign → 200

GET {{baseUrl}}/purchases?year=2026&month=12&q=50%25&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Search with only spaces is the same as no search → 200

GET {{baseUrl}}/purchases?year=2026&month=11&q=%20%20&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Search combined with status and category → 200

GET {{baseUrl}}/purchases?year=2026&month=9&q=uber&status=PENDING&category_id=2&page=2&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Canceled filter → 200 with total_amount "0"

GET {{baseUrl}}/purchases?year=2026&month=11&status=CANCELED&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Validation: q above 255 characters → 422

GET {{baseUrl}}/purchases?year=2026&month=11&q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&page_size=8
Authorization: Bearer {{accessToken}}

### LIST — Page 2 with 5 items per page

GET {{baseUrl}}/purchases?page=2&page_size=5
Authorization: Bearer {{accessToken}}

### LIST — Validation: invalid month → 400

GET {{baseUrl}}/purchases?month=13
Authorization: Bearer {{accessToken}}

### LIST — Validation: page_size above limit (>100) → 422

GET {{baseUrl}}/purchases?page_size=200
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# SUMMARY  GET /purchases/summary  → 200 | 400
# today is the client's local date; it only decides the period (UNTIL_DAY or FULL_MONTH).
# ─────────────────────────────────────────────────────────────────────────────

### SUMMARY — Current month, compared up to today's day → 200 UNTIL_DAY

GET {{baseUrl}}/purchases/summary?year=2026&month=11&today=2026-11-10
Authorization: Bearer {{accessToken}}

### SUMMARY — Other month, whole months → 200 FULL_MONTH

GET {{baseUrl}}/purchases/summary?year=2026&month=9&today=2026-11-10
Authorization: Bearer {{accessToken}}

### SUMMARY — Previous month shorter (whole February) → 200

GET {{baseUrl}}/purchases/summary?year=2027&month=3&today=2027-03-31
Authorization: Bearer {{accessToken}}

### SUMMARY — 31st against a 30-day month → 200 previous_until_day 30

GET {{baseUrl}}/purchases/summary?year=2026&month=10&today=2026-10-31
Authorization: Bearer {{accessToken}}

### SUMMARY — January of year 1 has no previous month → 200 NO_BASE

GET {{baseUrl}}/purchases/summary?year=1&month=1&today=2026-11-10
Authorization: Bearer {{accessToken}}

### SUMMARY — Validation: missing today → 400

GET {{baseUrl}}/purchases/summary?year=2026&month=11
Authorization: Bearer {{accessToken}}

### SUMMARY — Validation: month 13 → 400

GET {{baseUrl}}/purchases/summary?year=2026&month=13&today=2026-11-10
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# OVERVIEW  GET /purchases/overview  → 200 | 400
# Blocks of the home page from one snapshot; today decides the current month, the average and the forecast days.
# ─────────────────────────────────────────────────────────────────────────────

### OVERVIEW — Current month (average up to today, forecast days) → 200

GET {{baseUrl}}/purchases/overview?year=2026&month=11&today=2026-11-10
Authorization: Bearer {{accessToken}}

### OVERVIEW — Past month (average over the whole month) → 200

GET {{baseUrl}}/purchases/overview?year=2026&month=9&today=2026-11-10
Authorization: Bearer {{accessToken}}

### OVERVIEW — Future month → 200

GET {{baseUrl}}/purchases/overview?year=2026&month=12&today=2026-11-10
Authorization: Bearer {{accessToken}}

### OVERVIEW — Leap February has 29 days → 200

GET {{baseUrl}}/purchases/overview?year=2028&month=2&today=2026-11-10
Authorization: Bearer {{accessToken}}

### OVERVIEW — Validation: missing today → 400

GET {{baseUrl}}/purchases/overview?year=2026&month=11
Authorization: Bearer {{accessToken}}

### OVERVIEW — Validation: year 10000 → 400

GET {{baseUrl}}/purchases/overview?year=10000&month=1&today=2026-11-10
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# UPDATE  PUT /purchases/{id}  → 200 | 404 | 422
# ─────────────────────────────────────────────────────────────────────────────

### UPDATE — Update existing entry

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Electricity bill — updated",
  "category_id":    3,
  "payment_method_id": 2,
  "amount":         "180.00",
  "status":         "PAID"
}

### UPDATE — Unknown ID → 404 NOT_FOUND

PUT {{baseUrl}}/purchases/999999
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Nonexistent",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### UPDATE — Unknown category_id → 404 CATEGORY_NOT_FOUND

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Unknown category",
  "category_id":    999999,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### UPDATE — Unknown payment_method_id → 404 PAYMENT_METHOD_NOT_FOUND

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Unknown payment method",
  "category_id":    1,
  "payment_method_id": 999999,
  "amount":         "50.00",
  "status":         "PENDING"
}

### UPDATE — Validation: negative amount → 422

