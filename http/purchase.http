  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validation: unknown category_id → 404 CATEGORY_NOT_FOUND

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    999999,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Archived category → 404 CATEGORY_NOT_FOUND
# Archive the category first.

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
