# Purchase Entries API
# Extension: REST Client (humao.rest-client)
# https://marketplace.visualstudio.com/items?itemName=humao.rest-client
#
# Contract:
#   purchase_date  → string "YYYY-MM-DD"   (Date type, no time)
#   amount         → string decimal        (e.g. "174.65", not a float number)
#   category_id    → int64                 (ID of a global category or one of the user's)
#   status         → PENDING | PAID | CANCELED
#   payment_method_id → int64              (ID of a global payment method or one of the user's)
#   total_amount   → string decimal        (sum of the filter without CANCELED)
#   q              → text searched in the description, ignoring case and accents (max 255)
#   theme          → LIGHT | DARK | null (GET /users/me)
#   icon           → TAG | HEART | SMILE | BOOK | CAR | HOUSE | FOOD | CARD | GIFT | SPARKLE
#   color          → FOOD | TRANSPORT | HOME | HEALTH | EDUCATION | LEISURE (NEUTRAL only in responses)
#   archived_at    → RFC 3339 or null
#   previous_until_day → last day summed of the previous month (null in FULL_MONTH)

@baseUrl = http://localhost:8080/api/v1
@contentType = application/json
@name = Test User
@email = user@example.com
@password = password123
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ3ZS1zeW5jLWFwaSIsInN1YiI6IjIiLCJhdWQiOlsid2Utc3luYy1hcGkiXSwiZXhwIjoxNzkxNzY0NzQwLCJpYXQiOjE3OTE3NjM4NDB9.kcfmbmZrBh9EvxKqnG0em9nA6LJEqXh4HegVlzkGQvY
@refreshToken = J4cBH6R-AWVD0YYlZACJf34QcKpOEydJGqV7zLIWKBY

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

### AUTH — Register → 201

curl -i -X POST "{{baseUrl}}/auth/register" \
  -H "Content-Type: {{contentType}}" \
  -d '{"name":"{{name}}","email":"{{email}}","password":"{{password}}"}'

### AUTH — Register without name → 422 VALIDATION_ERROR

curl -i -X POST "{{baseUrl}}/auth/register" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Valid login → 200

curl -i -X POST "{{baseUrl}}/auth/login" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Refresh → 200

curl -i -X POST "{{baseUrl}}/auth/refresh" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

### AUTH — Logout → 204

curl -i -X POST "{{baseUrl}}/auth/logout" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

# ─────────────────────────────────────────────────────────────────────────────
# USERS  /users  (Bearer token required)
# ─────────────────────────────────────────────────────────────────────────────

### USERS — Current user → 200

GET {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}

### USERS — Current user without token → 401

GET {{baseUrl}}/users/me

### USERS — Update profile → 200

PUT {{baseUrl}}/users/me/profile
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Jonas Silva"
}

### USERS — Update profile ignores email → 200 (email unchanged)

PUT {{baseUrl}}/users/me/profile
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Jonas Silva",
  "email": "other@example.com"
}

### USERS — Validation: name with 1 character → 422

PUT {{baseUrl}}/users/me/profile
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "J"
}

### USERS — Save theme → 200

PUT {{baseUrl}}/users/me/preferences
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "theme": "DARK"
}

### USERS — Validation: lowercase theme → 422

PUT {{baseUrl}}/users/me/preferences
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "theme": "dark"
}

### USERS — Change password → 200 with a new token pair
# Other sessions of the user end (their tokens answer 401). Afterwards, set @accessToken to the returned
# access_token and @password to the new password, or the next requests answer 401/403.

PUT {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "current_password": "{{password}}",
  "new_password": "new-password-2026"
}

### USERS — Wrong current password → 403 INVALID_PASSWORD

PUT {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "current_password": "wrong-password",
  "new_password": "new-password-2026"
}

### USERS — Same password → 422

PUT {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "current_password": "{{password}}",
  "new_password": "{{password}}"
}

### USERS — Delete account with the wrong password → 403 INVALID_PASSWORD

DELETE {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "password": "wrong-password"
}

### USERS — Delete account → 204
# Run last: it deletes the user and every purchase.

DELETE {{baseUrl}}/users/me
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "password": "{{password}}"
}

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORIES  /categories
# All routes require a Bearer token.
# Names are compared ignoring case and accents. Own categories are archived, not deleted:
# PUT /categories/{id}/archive archives, DELETE /categories/{id}/archive reactivates.
# The examples assume the first own category gets id 7 and the second id 8.
# ─────────────────────────────────────────────────────────────────────────────

### CATEGORIES — List all (global + personal, archived included) → 200

GET {{baseUrl}}/categories
Authorization: Bearer {{accessToken}}

### CATEGORIES — Create personal category → 201

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Pets",
  "icon": "HEART",
  "color": "LEISURE"
}

### CATEGORIES — Create a second personal category → 201

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Assinaturas",
  "icon": "CARD",
  "color": "HOME"
}

### CATEGORIES — Create again with the same name → 409 NAME_CONFLICT

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "pets",
  "icon": "HEART",
  "color": "LEISURE"
}

### CATEGORIES — Create with a default category's name, ignoring accents → 409 DEFAULT_NAME_CONFLICT

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "saude",
  "icon": "HEART",
  "color": "HEALTH"
}

### CATEGORIES — Validation: name above 40 characters → 422

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "A category name that is longer than forty characters",
  "icon": "TAG",
  "color": "FOOD"
}

### CATEGORIES — Validation: NEUTRAL color → 422

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Gatos",
  "icon": "HEART",
  "color": "NEUTRAL"
}

### CATEGORIES — Update name, icon and color → 200

PUT {{baseUrl}}/categories/7
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Animais",
  "icon": "HOUSE",
  "color": "HOME"
}

### CATEGORIES — Try to edit a default category → 403

PUT {{baseUrl}}/categories/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Food",
  "icon": "FOOD",
  "color": "FOOD"
}

### CATEGORIES — Archive personal category → 204

PUT {{baseUrl}}/categories/7/archive
Authorization: Bearer {{accessToken}}

### CATEGORIES — Archive again → 204 (idempotent)

PUT {{baseUrl}}/categories/7/archive
Authorization: Bearer {{accessToken}}

### CATEGORIES — Rename to the name of an archived one → 409 ARCHIVED_NAME_CONFLICT

PUT {{baseUrl}}/categories/8
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "animais",
  "icon": "CARD",
  "color": "HOME"
}

### CATEGORIES — Create with the name of an archived one → 200 (reactivated)
# The stored name ("Animais") is kept; icon and color become the ones sent.

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "ANIMAIS",
  "icon": "SMILE",
  "color": "LEISURE"
}

### CATEGORIES — Reactivate → 204

DELETE {{baseUrl}}/categories/7/archive
Authorization: Bearer {{accessToken}}

### CATEGORIES — Try to archive a default category → 403

PUT {{baseUrl}}/categories/1/archive
Authorization: Bearer {{accessToken}}

### CATEGORIES — DELETE /categories/{id} no longer exists → 405

DELETE {{baseUrl}}/categories/7
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT METHODS  /payment-methods
# All routes require a Bearer token.
# Seeded globals: 1 Dinheiro, 2 Cartão de crédito, 3 Cartão de débito, 4 Pix,
# 5 Transferência bancária, 6 Boleto.
# Same rules as categories, without icon and color (sent ones are ignored).
# The examples assume the first own payment method gets id 7 and the second id 8.
# ─────────────────────────────────────────────────────────────────────────────

### PAYMENT METHODS — List all (global + personal, archived included) → 200

GET {{baseUrl}}/payment-methods
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Create personal payment method → 201

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Vale-refeição"
}

### PAYMENT METHODS — Create a second personal payment method → 201

