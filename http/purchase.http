# Purchase Entries API
# Extensão: REST Client (humao.rest-client)
# https://marketplace.visualstudio.com/items?itemName=humao.rest-client
#
# Contrato:
#   purchase_date  → string "YYYY-MM-DD"   (tipo Date, sem horário)
#   amount         → string decimal        (ex: "174.65", não número float)
#   category_id    → int64                 (ID de uma categoria global ou do usuário)
#   status         → PENDING | PAID | CANCELED
#   payment_method → CASH | CREDIT_CARD | DEBIT_CARD | PIX | BANK_TRANSFER | BOLETO

@baseUrl = http://localhost:8080/api/v1
@contentType = application/json
@email = user@example.com
@password = password123
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ3ZS1zeW5jLWFwaSIsInN1YiI6IjIiLCJhdWQiOlsid2Utc3luYy1hcGkiXSwiZXhwIjoxNzkxNzY0NzQwLCJpYXQiOjE3OTE3NjM4NDB9.kcfmbmZrBh9EvxKqnG0em9nA6LJEqXh4HegVlzkGQvY
@refreshToken = J4cBH6R-AWVD0YYlZACJf34QcKpOEydJGqV7zLIWKBY

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

### AUTH — Cadastro → 201

curl -i -X POST "{{baseUrl}}/auth/register" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Login válido → 200

curl -i -X POST "{{baseUrl}}/auth/login" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Refresh → 200

curl -i -X POST "{{baseUrl}}/auth/refresh" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

### AUTH — Logout → 204

curl -i -X POST "{{baseUrl}}/auth/logout" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORIES  /categories
# Todas as rotas requerem Bearer token.
# ─────────────────────────────────────────────────────────────────────────────

### CATEGORIES — Listar todas (globais + personalizadas) → 200

GET {{baseUrl}}/categories
Authorization: Bearer {{accessToken}}

### CATEGORIES — Criar categoria personalizada → 201

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Gasolina"
}

### CATEGORIES — Criar categoria com nome duplicado → 409

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Gasolina"
}

### CATEGORIES — Criar categoria com nome igual a global → 409

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Alimentação"
}

### CATEGORIES — Renomear categoria personalizada → 200

PUT {{baseUrl}}/categories/7
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Combustível"
}

### CATEGORIES — Tentar editar categoria global → 403

PUT {{baseUrl}}/categories/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Comida"
}

### CATEGORIES — Deletar categoria personalizada sem uso → 204

DELETE {{baseUrl}}/categories/7
Authorization: Bearer {{accessToken}}

### CATEGORIES — Deletar categoria em uso → 409

DELETE {{baseUrl}}/categories/5
Authorization: Bearer {{accessToken}}

### CATEGORIES — Tentar deletar categoria global → 403

DELETE {{baseUrl}}/categories/1
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# CREATE  POST /purchases  → 201
# category_id: use o ID retornado por GET /categories
# ─────────────────────────────────────────────────────────────────────────────

### CREATE — Conta de energia com categoria global Moradia (id=3)

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Conta de energia",
  "category_id":    3,
  "payment_method": "PIX",
  "amount":         "174.65",
  "status":         "PENDING"
}

### CREATE — Internet com categoria global Moradia

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Internet",
  "category_id":    3,
  "payment_method": "BOLETO",
  "amount":         "99.99",
  "status":         "PAID"
}

### CREATE — Aluguel com categoria global Moradia

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-05",
  "description":    "Aluguel julho",
  "category_id":    3,
  "payment_method": "BANK_TRANSFER",
  "amount":         "1500.00",
  "status":         "PENDING"
}

### CREATE — Validação: category_id zero → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Teste inválido",
  "category_id":    0,
  "payment_method": "PIX",
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validação: category_id inexistente → 404

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Teste inválido",
  "category_id":    999999,
  "payment_method": "PIX",
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validação: amount zero → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Teste inválido",
  "category_id":    1,
  "payment_method": "PIX",
  "amount":         "0",
  "status":         "PENDING"
}

### CREATE — Validação: status inválido → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Teste inválido",
  "category_id":    1,
  "payment_method": "PIX",
  "amount":         "50.00",
  "status":         "INVALIDO"
}

### CREATE — Validação: payment_method inválido → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Teste inválido",
  "category_id":    1,
  "payment_method": "BITCOIN",
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validação: purchase_date formato errado → 400

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01T00:00:00Z",
  "description":    "Data no formato errado",
  "category_id":    1,
  "payment_method": "PIX",
  "amount":         "50.00",
  "status":         "PENDING"
}

# ─────────────────────────────────────────────────────────────────────────────
# GET BY ID  GET /purchases/{id}  → 200 | 404
# ─────────────────────────────────────────────────────────────────────────────

### GET BY ID — Buscar por ID existente

GET {{baseUrl}}/purchases/1
Authorization: Bearer {{accessToken}}

### GET BY ID — ID inexistente → 404

GET {{baseUrl}}/purchases/999999
Authorization: Bearer {{accessToken}}

### GET BY ID — ID inválido (não numérico) → 400

GET {{baseUrl}}/purchases/abc
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# LIST  GET /purchases  → 200
# Paginação: page (default 1), page_size (default 20, max 100)
# ─────────────────────────────────────────────────────────────────────────────

### LIST — Sem filtros (página 1, 20 itens)

GET {{baseUrl}}/purchases
Authorization: Bearer {{accessToken}}

### LIST — Filtrar por mês e ano

GET {{baseUrl}}/purchases?month=7&year=2024
Authorization: Bearer {{accessToken}}

### LIST — Filtrar por status PENDING

GET {{baseUrl}}/purchases?status=PENDING
Authorization: Bearer {{accessToken}}

### LIST — Filtrar por categoria (ID exato)

GET {{baseUrl}}/purchases?category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Filtrar por forma de pagamento

GET {{baseUrl}}/purchases?payment_method=PIX
Authorization: Bearer {{accessToken}}

### LIST — Filtro combinado: mês + ano + status + categoria

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Filtro completo com paginação

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3&payment_method=PIX&page=1&page_size=10
Authorization: Bearer {{accessToken}}

### LIST — Página 2 com 5 itens por página

GET {{baseUrl}}/purchases?page=2&page_size=5
Authorization: Bearer {{accessToken}}

### LIST — Validação: mês inválido → 400

GET {{baseUrl}}/purchases?month=13
Authorization: Bearer {{accessToken}}

### LIST — Validação: page_size acima do limite (>100) → 422

GET {{baseUrl}}/purchases?page_size=200
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# UPDATE  PUT /purchases/{id}  → 200 | 404 | 422
# ─────────────────────────────────────────────────────────────────────────────

### UPDATE — Atualizar lançamento existente

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Conta de energia — atualizado",
  "category_id":    3,
  "payment_method": "CREDIT_CARD",
  "amount":         "180.00",
  "status":         "PAID"
}

### UPDATE — ID inexistente → 404

PUT {{baseUrl}}/purchases/999999
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Inexistente",
  "category_id":    1,
  "payment_method": "PIX",
  "amount":         "50.00",
  "status":         "PENDING"
}

### UPDATE — Validação: amount negativo → 422

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Valor inválido",
  "category_id":    1,
  "payment_method": "PIX",
  "amount":         "-10.00",
  "status":         "PENDING"
}

# ─────────────────────────────────────────────────────────────────────────────
# DELETE  DELETE /purchases/{id}  → 204 | 404
# ─────────────────────────────────────────────────────────────────────────────

### DELETE — Remover lançamento existente → 204

DELETE {{baseUrl}}/purchases/1
Authorization: Bearer {{accessToken}}

### DELETE — ID inexistente → 404

DELETE {{baseUrl}}/purchases/999999
Authorization: Bearer {{accessToken}}

### DELETE — ID inválido → 400

DELETE {{baseUrl}}/purchases/0
Authorization: Bearer {{accessToken}}
