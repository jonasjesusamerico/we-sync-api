# Purchase Entries API
# Extension: REST Client (humao.rest-client)
# https://marketplace.visualstudio.com/items?itemName=humao.rest-client
#
# Contract:
#   purchase_date  → string "YYYY-MM-DD"   (Date type, no time)
#   amount         → string decimal        (e.g. "174.65", not a float number)
#   category_id    → int64                 (ID of a global category or one of the user's)
#   status         → PENDING | PAID | CANCELED
#   payment_method_id → int64              (ID of a global payment method or one of the user's)

@baseUrl = http://localhost:8080/api/v1
@contentType = application/json
@email = user@example.com
@password = password123
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ3ZS1zeW5jLWFwaSIsInN1YiI6IjIiLCJhdWQiOlsid2Utc3luYy1hcGkiXSwiZXhwIjoxNzkxNzY0NzQwLCJpYXQiOjE3OTE3NjM4NDB9.kcfmbmZrBh9EvxKqnG0em9nA6LJEqXh4HegVlzkGQvY
@refreshToken = J4cBH6R-AWVD0YYlZACJf34QcKpOEydJGqV7zLIWKBY

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

### AUTH — Register → 201

curl -i -X POST "{{baseUrl}}/auth/register" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Valid login → 200

curl -i -X POST "{{baseUrl}}/auth/login" \
  -H "Content-Type: {{contentType}}" \
  -d '{"email":"{{email}}","password":"{{password}}"}'

### AUTH — Refresh → 200

curl -i -X POST "{{baseUrl}}/auth/refresh" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

### AUTH — Logout → 204

curl -i -X POST "{{baseUrl}}/auth/logout" \
  -H "Content-Type: {{contentType}}" \
  -d '{"refresh_token":"{{refreshToken}}"}'

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORIES  /categories
# All routes require a Bearer token.
# ─────────────────────────────────────────────────────────────────────────────

### CATEGORIES — List all (global + personal) → 200

GET {{baseUrl}}/categories
Authorization: Bearer {{accessToken}}

### CATEGORIES — Create personal category → 201

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Gas"
}

### CATEGORIES — Create category with duplicate name → 409

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Gas"
}

### CATEGORIES — Create category with a global category's name → 409

POST {{baseUrl}}/categories
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Alimentação"
}

### CATEGORIES — Rename personal category → 200

PUT {{baseUrl}}/categories/7
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Fuel"
}

### CATEGORIES — Try to edit a global category → 403

PUT {{baseUrl}}/categories/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Food"
}

### CATEGORIES — Delete unused personal category → 204

DELETE {{baseUrl}}/categories/7
Authorization: Bearer {{accessToken}}

### CATEGORIES — Delete category in use → 409

DELETE {{baseUrl}}/categories/5
Authorization: Bearer {{accessToken}}

### CATEGORIES — Try to delete a global category → 403

DELETE {{baseUrl}}/categories/1
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT METHODS  /payment-methods
# All routes require a Bearer token.
# Seeded globals: 1 Dinheiro, 2 Cartão de crédito, 3 Cartão de débito, 4 Pix,
# 5 Transferência bancária, 6 Boleto.
# ─────────────────────────────────────────────────────────────────────────────

### PAYMENT METHODS — List all (global + personal) → 200

GET {{baseUrl}}/payment-methods
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Create personal payment method → 201

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Nubank"
}

### PAYMENT METHODS — Create with duplicate name (case-insensitive) → 409

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "nubank"
}

### PAYMENT METHODS — Create with a global payment method's name → 409

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Pix"
}

### PAYMENT METHODS — Create with blank name → 422

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "   "
}

### PAYMENT METHODS — Rename personal payment method → 200

PUT {{baseUrl}}/payment-methods/7
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Nubank Visa"
}

### PAYMENT METHODS — Try to edit a global payment method → 403

PUT {{baseUrl}}/payment-methods/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Cash"
}

### PAYMENT METHODS — Delete unused personal payment method → 204

DELETE {{baseUrl}}/payment-methods/7
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Try to delete a global payment method → 403

DELETE {{baseUrl}}/payment-methods/1
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# CREATE  POST /purchases  → 201
# category_id: use an ID returned by GET /categories
# payment_method_id: use an ID returned by GET /payment-methods
# ─────────────────────────────────────────────────────────────────────────────

### CREATE — Electricity bill with global category Moradia (id=3)

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Electricity bill",
  "category_id":    3,
  "payment_method_id": 4,
  "amount":         "174.65",
  "status":         "PENDING"
}

### CREATE — Internet with global category Moradia

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Internet",
  "category_id":    3,
  "payment_method_id": 6,
  "amount":         "99.99",
  "status":         "PAID"
}

### CREATE — Rent with global category Moradia

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-05",
  "description":    "July rent",
  "category_id":    3,
  "payment_method_id": 5,
  "amount":         "1500.00",
  "status":         "PENDING"
}

### CREATE — Validation: zero category_id → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    0,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validation: unknown category_id → 404

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    999999,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validation: zero amount → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "0",
  "status":         "PENDING"
}

### CREATE — Validation: invalid status → 422

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "INVALIDO"
}

### CREATE — Validation: unknown payment_method_id → 404

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid test",
  "category_id":    1,
  "payment_method_id": 999999,
  "amount":         "50.00",
  "status":         "PENDING"
}

### CREATE — Validation: wrong purchase_date format → 400

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01T00:00:00Z",
  "description":    "Wrong date format",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

# ─────────────────────────────────────────────────────────────────────────────
# GET BY ID  GET /purchases/{id}  → 200 | 404
# ─────────────────────────────────────────────────────────────────────────────

### GET BY ID — Existing ID

GET {{baseUrl}}/purchases/1
Authorization: Bearer {{accessToken}}

### GET BY ID — Unknown ID → 404

GET {{baseUrl}}/purchases/999999
Authorization: Bearer {{accessToken}}

### GET BY ID — Invalid ID (non-numeric) → 400

GET {{baseUrl}}/purchases/abc
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# LIST  GET /purchases  → 200
# Pagination: page (default 1), page_size (default 20, max 100)
# ─────────────────────────────────────────────────────────────────────────────

### LIST — No filters (page 1, 20 items)

GET {{baseUrl}}/purchases
Authorization: Bearer {{accessToken}}

### LIST — Filter by month and year

GET {{baseUrl}}/purchases?month=7&year=2024
Authorization: Bearer {{accessToken}}

### LIST — Filter by status PENDING

GET {{baseUrl}}/purchases?status=PENDING
Authorization: Bearer {{accessToken}}

### LIST — Filter by category (exact ID)

GET {{baseUrl}}/purchases?category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Filter by payment method (exact ID)

GET {{baseUrl}}/purchases?payment_method_id=4
Authorization: Bearer {{accessToken}}

### LIST — Combined filter: month + year + status + category

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3
Authorization: Bearer {{accessToken}}

### LIST — Full filter with pagination

GET {{baseUrl}}/purchases?month=7&year=2024&status=PENDING&category_id=3&payment_method_id=4&page=1&page_size=10
Authorization: Bearer {{accessToken}}

### LIST — Page 2 with 5 items per page

GET {{baseUrl}}/purchases?page=2&page_size=5
Authorization: Bearer {{accessToken}}

### LIST — Validation: invalid month → 400

GET {{baseUrl}}/purchases?month=13
Authorization: Bearer {{accessToken}}

### LIST — Validation: page_size above limit (>100) → 422

GET {{baseUrl}}/purchases?page_size=200
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# UPDATE  PUT /purchases/{id}  → 200 | 404 | 422
# ─────────────────────────────────────────────────────────────────────────────

### UPDATE — Update existing entry

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Electricity bill — updated",
  "category_id":    3,
  "payment_method_id": 2,
  "amount":         "180.00",
  "status":         "PAID"
}

### UPDATE — Unknown ID → 404

PUT {{baseUrl}}/purchases/999999
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Nonexistent",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "50.00",
  "status":         "PENDING"
}

### UPDATE — Validation: negative amount → 422

PUT {{baseUrl}}/purchases/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Invalid amount",
  "category_id":    1,
  "payment_method_id": 4,
  "amount":         "-10.00",
  "status":         "PENDING"
}

# ─────────────────────────────────────────────────────────────────────────────
# DELETE  DELETE /purchases/{id}  → 204 | 404
# ─────────────────────────────────────────────────────────────────────────────

### DELETE — Remove existing entry → 204

DELETE {{baseUrl}}/purchases/1
Authorization: Bearer {{accessToken}}

### DELETE — Unknown ID → 404

DELETE {{baseUrl}}/purchases/999999
Authorization: Bearer {{accessToken}}

### DELETE — Invalid ID → 400

DELETE {{baseUrl}}/purchases/0
Authorization: Bearer {{accessToken}}
