Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Cartão da empresa"
}

### PAYMENT METHODS — Create again with the same name, ignoring accents → 409 NAME_CONFLICT

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "vale-refeicao"
}

### PAYMENT METHODS — Create with a default payment method's name → 409 DEFAULT_NAME_CONFLICT

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "pix"
}

### PAYMENT METHODS — Validation: blank name → 422

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "   "
}

### PAYMENT METHODS — Validation: name above 40 characters → 422

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "A payment method name longer than forty characters"
}

### PAYMENT METHODS — Rename personal payment method → 200

PUT {{baseUrl}}/payment-methods/8
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Cartão corporativo"
}

### PAYMENT METHODS — Try to edit a default payment method → 403

PUT {{baseUrl}}/payment-methods/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Cash"
}

### PAYMENT METHODS — Archive personal payment method → 204

PUT {{baseUrl}}/payment-methods/7/archive
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Archive again → 204 (idempotent)

PUT {{baseUrl}}/payment-methods/7/archive
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Rename to the name of an archived one → 409 ARCHIVED_NAME_CONFLICT

PUT {{baseUrl}}/payment-methods/8
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "Vale-refeição"
}

### PAYMENT METHODS — Create with the name of an archived one → 200 (reactivated)

POST {{baseUrl}}/payment-methods
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "VALE-REFEICAO"
}

### PAYMENT METHODS — Reactivate → 204

DELETE {{baseUrl}}/payment-methods/7/archive
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — Try to archive a default payment method → 403

PUT {{baseUrl}}/payment-methods/1/archive
Authorization: Bearer {{accessToken}}

### PAYMENT METHODS — DELETE /payment-methods/{id} no longer exists → 405

DELETE {{baseUrl}}/payment-methods/7
Authorization: Bearer {{accessToken}}

# ─────────────────────────────────────────────────────────────────────────────
# CREATE  POST /purchases  → 201
# category_id: use an ID returned by GET /categories
# payment_method_id: use an ID returned by GET /payment-methods
# ─────────────────────────────────────────────────────────────────────────────

### CREATE — Electricity bill with global category Moradia (id=3)

POST {{baseUrl}}/purchases
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "purchase_date":  "2024-07-01",
  "description":    "Electricity bill",
  "category_id":    3,
  "payment_method_id": 4,
  "amount":         "174.65",
  "status":         "PENDING"
}

